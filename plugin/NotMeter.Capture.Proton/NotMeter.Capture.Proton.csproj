<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NotMeter.Capture.Proton</AssemblyName>
    <RootNamespace>NotMeter.Capture.Proton</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Path to NotMeter.dll extracted from NotMeter.exe (see build.sh). -->
    <NotMeterDll Condition="'$(NotMeterDll)' == ''">$(MSBuildThisFileDirectory)../../build/ref/NotMeter.dll</NotMeterDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the meter; at runtime the meter's own copy is used. -->
    <Reference Include="NotMeter">
      <HintPath>$(NotMeterDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
